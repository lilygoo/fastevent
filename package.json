{
  "name": "fastevent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/**/*.test.ts",
    "bootstrap": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/bootstrap.ts",
    "recalculate-runs": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/recalculate-runs.ts",
    "daily-refresh": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/daily-refresh.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "lucide-react": "0.563.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
